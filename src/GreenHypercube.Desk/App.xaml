<Application x:Class="GreenHypercube.Desk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ground" Color="#F2F3EE"/>
        <SolidColorBrush x:Key="Ink" Color="#111713"/>
        <SolidColorBrush x:Key="Muted" Color="#4E5A52"/>
        <SolidColorBrush x:Key="Accent" Color="#127A51"/>
        <SolidColorBrush x:Key="Panel" Color="#FBFCF9"/>
    </Application.Resources>
</Application>
