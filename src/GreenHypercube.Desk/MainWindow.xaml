<Window x:Class="GreenHypercube.Desk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Green Hypercube"
        Width="840"
        Background="{StaticResource Ground}"
        Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Green Hypercube" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,16"
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   Text="Sensory search versus random. Mean AUDC advantage and 95% interval over independent landscapes. The assay is hidden from the searcher."/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="Status" Margin="0,8,0,0" Foreground="{StaticResource Muted}" Text="Ready."/>
            <Button x:Name="RunButton" Content="Run ensemble" Width="140" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Padding="12,6" Click="Run_Click"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
        <Border Background="{StaticResource Panel}" Padding="16">
            <ListView x:Name="Rows" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Condition" Width="400" DisplayMemberBinding="{Binding Condition}"/>
                        <GridViewColumn Header="Mean" Width="80" DisplayMemberBinding="{Binding Mean}"/>
                        <GridViewColumn Header="95% CI" Width="160" DisplayMemberBinding="{Binding Interval}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
